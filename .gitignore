# ============================================================
# Python
# ============================================================

# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging / builds
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Last.fm generated outputs
figures/lastfm/
reports/lastfm/

# ============================================================
# uv
# ============================================================

# uv's project environment is local and reproducible
.venv/

# DO NOT ignore:
# uv.lock
# pyproject.toml
# .python-version


# ============================================================
# R / renv
# ============================================================

# R session files
.Rhistory
.RData
.Ruserdata

# RStudio
.Rproj.user/

# renv project library / local state
renv/library/
renv/local/
renv/staging/
renv/python/
renv/cellar/

# renv temporary locking state
renv/lock/

# DO NOT ignore:
# renv.lock
# .Rprofile
# renv/activate.R
# renv/settings.json


# ============================================================
# Data
# ============================================================

# Real/private/raw data should NEVER be committed by default
data/raw/*
!data/raw/.gitkeep

# Generated processed data
data/processed/*
!data/processed/.gitkeep

# Synthetic data can be committed selectively.
# For now, keep the directory available:
!data/synthetic/

# Common large data formats
*.parquet
*.feather
*.arrow

# Personal Last.fm snapshots
data/raw/lastfm/*
!data/raw/lastfm/.gitkeep

# Local analytical databases
data/processed/lastfm/*.duckdb
data/processed/lastfm/*.duckdb.wal

# ============================================================
# Reports / generated outputs
# ============================================================

*.html
*.pdf
*.docx

# Quarto generated/cache directories
.quarto/
*_files/
_freeze/

# ============================================================
# Secrets / environment variables
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key

# ============================================================
# OS / Editors
# ============================================================

.DS_Store
Thumbs.db

.vscode/
.idea/

# ============================================================
# Misc
# ============================================================

*.log
*.tmp
*.temp
